<?xml version="1.0" encoding="utf-8"?>
<KerbalismHostedPlugin>
  <Plugin id="KerbalismCryo"
          assembly="zKerbalismCryo"
          dll="zKerbalismCryo.dll"
          initType="KerbalismCryo.KerbalismCryoCoreInit" />
  <RequireKerbalism warnTitleLoc="#LOC_KerbalismCryo_KerbalismNotFound_Title"
                    warnMessageLoc="#LOC_KerbalismCryo_KerbalismNotFound_Msg"
                    quitButtonLoc="#LOC_KerbalismCryo_Quit" />
  <RequireAssembly name="zKerbalismBridge" />
  <RequireAssembly name="SimpleBoiloff" optional="true" />
  <RequireAssembly name="SystemHeat" optional="true" />
</KerbalismHostedPlugin>
